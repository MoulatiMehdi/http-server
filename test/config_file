server {
    listen 0.0.0.0:8080;

    root ./;
    
     location / 
     {
         allowed_methods GET;
         index index.html;
         cgi .bla ./cgi-bin/cgi_tester;  
     }
     location /post_body 
     {
         allowed_methods POST;
         client_max_body_size 100;
         cgi .bla ./cgi-bin/cgi_tester;  
     }
     location /directory/ 
     {
         allowed_methods GET;
         root ./YoupiBanane/;
         index youpi.bad_extension;

         cgi .bla ./cgi-bin/cgi_tester;  
     }

}
